# =============================================================================
# vrf-chat backend — example environment configuration
#
# Copy to `.env` and fill in real values. This file is kept in sync with
# Documentation/system-design/04-provider-abstractions.md and
# Documentation/system-design/08-authentication-rbac.md — sections below are
# added incrementally as each Fase 0 backend task is implemented (see
# Documentation/project-milestones/01-phase-0-foundation.md).
# =============================================================================

# ---- Generic application settings ----
APP_NAME=vrf-chat-backend
APP_ENV=development            # development | test | staging | production
DEBUG=true
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173   # comma-separated list, never wildcard (single-tenant app)

# ---- OpenTelemetry-compatible tracing (optional — no-op export if unset) ----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=vrf-chat-backend

# ---- First superuser bootstrap (consumed by Alembic data migration, see
#      app/db/migrations — idempotent: skipped if a user with this email
#      already exists). NEVER commit real credentials to source control. ----
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-me-please-1234
