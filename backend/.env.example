# =============================================================================
# vrf-chat backend — example environment configuration
#
# Copy to `.env` and fill in real values. This file is kept in sync with
# Documentation/system-design/04-provider-abstractions.md and
# Documentation/system-design/08-authentication-rbac.md — sections below are
# added incrementally as each Fase 0 backend task is implemented (see
# Documentation/project-milestones/01-phase-0-foundation.md).
# =============================================================================

# ---- Generic application settings ----
APP_NAME=vrf-chat-backend
APP_ENV=development            # development | test | staging | production
DEBUG=true
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173   # comma-separated list, never wildcard (single-tenant app)

# ---- OpenTelemetry-compatible tracing (optional — no-op export if unset) ----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=vrf-chat-backend

# ---- First superuser bootstrap (consumed by Alembic data migration, see
#      app/db/migrations — idempotent: skipped if a user with this email
#      already exists). NEVER commit real credentials to source control. ----
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-me-please-1234

# ---- Database Engine abstraction (Postgres <-> MySQL), see
#      Documentation/system-design/04-provider-abstractions.md Bagian C ----
DB_ENGINE=postgresql            # postgresql | mysql
DB_HOST=localhost               # "postgres" (service name) when run via docker-compose
DB_PORT=5432                    # 5432 (postgresql) | 3306 (mysql)
DB_NAME=vrf_chatbot
DB_USER=vrf_app
DB_PASSWORD=change-me
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_SSL_MODE=prefer              # postgres: disable|allow|prefer|require|verify-ca|verify-full
                                 # mysql: DISABLED|PREFERRED|REQUIRED|VERIFY_CA|VERIFY_IDENTITY

# =============================================================================
# LLM Provider Abstraction, see
# Documentation/system-design/04-provider-abstractions.md Bagian A.
# Two structurally-identical slots: CHAT_LLM_* (answers users) and
# EVAL_JUDGE_LLM_* (LLM-as-judge — ideally a different provider than
# CHAT_LLM to avoid self-serving bias). Both fail-fast validated at app
# startup (app/llm_providers/factory.py).
# =============================================================================

# ---- CHAT LLM (answers users) ----
CHAT_LLM_PROVIDER=anthropic          # anthropic | google | openai | local
CHAT_LLM_MODEL=claude-sonnet-4-5-20250929
CHAT_LLM_API_KEY=sk-ant-...
CHAT_LLM_BASE_URL=                    # required only for provider=local, or to override endpoint
CHAT_LLM_TEMPERATURE=0.1
CHAT_LLM_MAX_TOKENS=4096
CHAT_LLM_TIMEOUT_SECONDS=25

# ---- EVAL JUDGE LLM (LLM-as-judge, ideally a different provider) ----
EVAL_JUDGE_LLM_PROVIDER=google
EVAL_JUDGE_LLM_MODEL=gemini-2.5-pro
EVAL_JUDGE_LLM_API_KEY=AIza...
EVAL_JUDGE_LLM_BASE_URL=
EVAL_JUDGE_LLM_TEMPERATURE=0.0
EVAL_JUDGE_LLM_MAX_TOKENS=4096
EVAL_JUDGE_LLM_TIMEOUT_SECONDS=60

# --- Example: Local (Ollama/vLLM, OpenAI-compatible endpoint) ---
# CHAT_LLM_PROVIDER=local
# CHAT_LLM_MODEL=llama3.1:8b-instruct
# CHAT_LLM_API_KEY=not-needed
# CHAT_LLM_BASE_URL=http://localhost:11434/v1

# =============================================================================
# Object Storage Abstraction, see
# Documentation/system-design/04-provider-abstractions.md Bagian B.
# minio (default dev, via WSL Docker) | s3 (prod, optional) | local (dev
# fallback without Docker storage). Fail-fast validated at app startup
# (app/storage/factory.py).
# =============================================================================
OBJECT_STORAGE_BACKEND=minio                 # minio | s3 | local
OBJECT_STORAGE_BUCKET=vrf-manuals
OBJECT_STORAGE_REGION=us-east-1               # kept non-empty even for MinIO (boto3 requires it)
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000  # REQUIRED for minio; empty for s3 (default AWS endpoint); ignored for local
OBJECT_STORAGE_USE_SSL=false                   # true for s3/production typically
OBJECT_STORAGE_FORCE_PATH_STYLE=true            # true for MinIO; false for AWS S3 (virtual-hosted style)
OBJECT_STORAGE_LOCAL_BASE_PATH=./data/object-storage   # only used when BACKEND=local
OBJECT_STORAGE_PRESIGNED_URL_EXPIRY_SECONDS=3600
OBJECT_STORAGE_LOCAL_TOKEN_SECRET=change-me-in-every-environment   # HMAC secret for local-backend emulated presigned URLs

# --- Example: AWS S3 (prod, opsional) ---
# OBJECT_STORAGE_BACKEND=s3
# OBJECT_STORAGE_ENDPOINT_URL=
# OBJECT_STORAGE_FORCE_PATH_STYLE=false
# OBJECT_STORAGE_REGION=ap-southeast-1

# --- Example: Local filesystem (dev without Docker storage / fast tests) ---
# OBJECT_STORAGE_BACKEND=local
# OBJECT_STORAGE_LOCAL_BASE_PATH=./data/object-storage

# ---- Redis (Celery broker/cache + /auth/login rate limiter), see
#      Documentation/system-design/08-authentication-rbac.md §5 ----
REDIS_HOST=localhost            # "redis" (service name) when run via docker-compose
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- Celery ----
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_GPU_QUEUE=gpu

# =============================================================================
# Authentication & RBAC, see
# Documentation/system-design/08-authentication-rbac.md.
# =============================================================================
JWT_SECRET_KEY=change-me-to-a-long-random-value-per-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_PATH=/api/v1/auth
# bcrypt cost factor — see 08-authentication-rbac.md §2 (14 evaluated as
# appropriate for this project's scale; MUST run off the event loop, see
# app/auth/password.py).
BCRYPT_COST_FACTOR=14
# /auth/login rate limiting — see 08-authentication-rbac.md §5.1
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# =============================================================================
# Ingestion Stage 1 — native PDF probe (PyMuPDF), see
# Documentation/system-design/02-ingestion-pipeline.md §3 and
# app/ingestion/native_probe.py. Starting-point heuristics — calibrated by
# the I1.6 benchmark, see backend/docs/i1.6-vram-benchmark-report.md.
# =============================================================================
NATIVE_PROBE_MIN_TEXT_CHARS=40
NATIVE_PROBE_VECTOR_DRAWING_THRESHOLD=50
NATIVE_PROBE_TEXT_DENSITY_MIN=0.0005

# =============================================================================
# Ingestion Stage 2 — Docling structural parser (canonical parser for 100% of
# pages), see Documentation/system-design/02-ingestion-pipeline.md §3-4 and
# app/ingestion/docling_parser.py. Only consumed by backend-worker-gpu, not
# validated at API startup.
# =============================================================================
DOCLING_DEVICE=cpu                      # [SA1.1, ratified 2026-08-10] cpu (dev default — PaddleOCR-VL's own VRAM footprint leaves no headroom to share) | cuda (supported override, e.g. cloud GPU with more headroom)
DOCLING_ICON_MAX_AREA_RATIO=0.02        # picture smaller than this fraction of page area -> icon
DOCLING_ICON_MAX_DIM_PT=80.0            # AND both dims below this (points) -> icon, else figure
# WAJIB true in dev — Docling and PaddleOCR-VL (Stage 4) must never be
# GPU-resident simultaneously on a 6GB card. See 02-ingestion-pipeline.md §4.
DOCLING_UNLOAD_BEFORE_PADDLE_STAGE=true

# =============================================================================
# Ingestion Stage 3 — deterministic cascade trigger rules (not an LLM call),
# see Documentation/system-design/02-ingestion-pipeline.md §3 and
# app/ingestion/cascade_trigger.py.
# THRESHOLD_TABLE: [SA1.1 KALIBRASI FINAL, 2026-08-09] 0.75 -> 0.90, based
# on real I1.6 50-page benchmark data (all real table_score observations
# were above 0.75, so it never triggered). THRESHOLD_TEXT: still a
# starting point, unchanged.
# =============================================================================
THRESHOLD_TABLE=0.90
THRESHOLD_TEXT=0.6

# =============================================================================
# Ingestion Stage 4 — PaddleOCR-VL cascade (fallback/enrichment only, never
# run for all pages), see Documentation/system-design/02-ingestion-pipeline.md
# §4 and app/ingestion/paddleocr_vl_cascade.py. Only consumed by
# backend-worker-gpu, not validated at API startup.
# =============================================================================
PADDLE_OCR_VL_BACKEND=local              # local | remote_api
PADDLE_OCR_VL_DEVICE=cuda                # cuda (dev default) | cpu (fallback)
PADDLE_OCR_VL_DTYPE=fp16                 # WAJIB fp16 in dev (RTX 3060 6GB)
PADDLE_OCR_VL_BATCH_SIZE=1               # WAJIB 1 in dev, not raised without I1.6 benchmark data
PADDLE_OCR_VL_MAX_CONCURRENT_WORKERS=1   # dev: 1 (single 6GB GPU, non-negotiable)
PADDLE_OCR_VL_API_URL=                   # required only when BACKEND=remote_api
PADDLE_OCR_VL_API_KEY=
PADDLE_OCR_VL_TIMEOUT_SECONDS=420
PADDLE_OCR_VL_MAX_RETRIES=1

# =============================================================================
# Vector Store abstraction, see
# Documentation/system-design/04-provider-abstractions.md Bagian D and
# app/retrieval/vector_store.py. Default MVP: Qdrant (only implemented
# provider — chroma/milvus fields declared for future use, Bagian D §6).
# =============================================================================
VECTOR_STORE_PROVIDER=qdrant             # qdrant (only implemented) | chroma | milvus (not implemented)
VECTOR_STORE_COLLECTION=vrf_chunks
VECTOR_STORE_DENSE_DIM=384                # BAAI/bge-small-en-v1.5 (EMBEDDER_DENSE_MODEL default) output dim
VECTOR_STORE_QDRANT_URL=http://localhost:6333   # "http://qdrant:6333" via docker-compose
VECTOR_STORE_QDRANT_API_KEY=
VECTOR_STORE_CHROMA_MODE=embedded
VECTOR_STORE_CHROMA_HOST=
VECTOR_STORE_CHROMA_PORT=8000
VECTOR_STORE_CHROMA_PERSIST_DIR=./data/chroma
VECTOR_STORE_MILVUS_URI=http://localhost:19530
VECTOR_STORE_MILVUS_TOKEN=

# =============================================================================
# Ingestion Stage: chunk embedding (I1.8), see
# Documentation/system-design/03-retrieval-chunking.md §6 and
# app/ingestion/embedder.py. fastembed (ONNX, CPU-friendly).
# =============================================================================
EMBEDDER_DENSE_MODEL=BAAI/bge-small-en-v1.5
EMBEDDER_SPARSE_MODEL=Qdrant/bm25

# =============================================================================
# Retrieval (C2.1), see Documentation/system-design/03-retrieval-chunking.md
# §6 and app/retrieval/hybrid_search.py. Circuit breaker per
# 05-streaming-and-api-contract.md §3 point 5.
# =============================================================================
RETRIEVAL_CIRCUIT_BREAKER_SECONDS=8.0
RETRIEVAL_DEFAULT_TOP_K=20
