# =============================================================================
# vrf-chat backend — example environment configuration
#
# Copy to `.env` and fill in real values. This file is kept in sync with
# Documentation/system-design/04-provider-abstractions.md and
# Documentation/system-design/08-authentication-rbac.md — sections below are
# added incrementally as each Fase 0 backend task is implemented (see
# Documentation/project-milestones/01-phase-0-foundation.md).
# =============================================================================

# ---- Generic application settings ----
APP_NAME=vrf-chat-backend
APP_ENV=development            # development | test | staging | production
DEBUG=true
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173   # comma-separated list, never wildcard (single-tenant app)

# ---- OpenTelemetry-compatible tracing (optional — no-op export if unset) ----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=vrf-chat-backend

# ---- First superuser bootstrap (consumed by Alembic data migration, see
#      app/db/migrations — idempotent: skipped if a user with this email
#      already exists). NEVER commit real credentials to source control. ----
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-me-please-1234

# ---- Database Engine abstraction (Postgres <-> MySQL), see
#      Documentation/system-design/04-provider-abstractions.md Bagian C ----
DB_ENGINE=postgresql            # postgresql | mysql
DB_HOST=localhost               # "postgres" (service name) when run via docker-compose
DB_PORT=5432                    # 5432 (postgresql) | 3306 (mysql)
DB_NAME=vrf_chatbot
DB_USER=vrf_app
DB_PASSWORD=change-me
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_SSL_MODE=prefer              # postgres: disable|allow|prefer|require|verify-ca|verify-full
                                 # mysql: DISABLED|PREFERRED|REQUIRED|VERIFY_CA|VERIFY_IDENTITY

# =============================================================================
# LLM Provider Abstraction, see
# Documentation/system-design/04-provider-abstractions.md Bagian A.
# Two structurally-identical slots: CHAT_LLM_* (answers users) and
# EVAL_JUDGE_LLM_* (LLM-as-judge — ideally a different provider than
# CHAT_LLM to avoid self-serving bias). Both fail-fast validated at app
# startup (app/llm_providers/factory.py).
# =============================================================================

# ---- CHAT LLM (answers users) ----
CHAT_LLM_PROVIDER=anthropic          # anthropic | google | openai | local
CHAT_LLM_MODEL=claude-sonnet-4-5-20250929
CHAT_LLM_API_KEY=sk-ant-...
CHAT_LLM_BASE_URL=                    # required only for provider=local, or to override endpoint
CHAT_LLM_TEMPERATURE=0.1
CHAT_LLM_MAX_TOKENS=4096
CHAT_LLM_TIMEOUT_SECONDS=25

# ---- EVAL JUDGE LLM (LLM-as-judge, ideally a different provider) ----
EVAL_JUDGE_LLM_PROVIDER=google
EVAL_JUDGE_LLM_MODEL=gemini-2.5-pro
EVAL_JUDGE_LLM_API_KEY=AIza...
EVAL_JUDGE_LLM_BASE_URL=
EVAL_JUDGE_LLM_TEMPERATURE=0.0
EVAL_JUDGE_LLM_MAX_TOKENS=4096
EVAL_JUDGE_LLM_TIMEOUT_SECONDS=60

# --- Example: Local (Ollama/vLLM, OpenAI-compatible endpoint) ---
# CHAT_LLM_PROVIDER=local
# CHAT_LLM_MODEL=llama3.1:8b-instruct
# CHAT_LLM_API_KEY=not-needed
# CHAT_LLM_BASE_URL=http://localhost:11434/v1
