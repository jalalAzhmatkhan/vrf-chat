# Copy this file to `.env` (or `.env.local`) for local development.
# All Vite env vars consumed by the app MUST be prefixed with VITE_.
# See src/lib/env.js for the loader/validator that reads these.

# Base URL of the backend API, INCLUDING the /api/v1 prefix.
# Local dev (backend run outside Docker):
VITE_API_BASE_URL=http://localhost:8000/api/v1

# When running via `docker compose` (see vrf-chat/docker-compose.yml,
# owned by Backend Engineer), the frontend container is typically built
# with this pointing at the backend-api service, e.g.:
# VITE_API_BASE_URL=http://backend-api:8000/api/v1
# (or left as the public host the browser can reach, since fetches run in
# the user's browser, not inside the frontend container — coordinate the
# correct value with Backend Engineer's docker-compose network setup.)
